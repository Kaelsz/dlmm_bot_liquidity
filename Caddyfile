# Frontal de Meteora Pool Radar.
#
# L'adresse du site est `RADAR_SITE` (dans .env), typiquement
# `https://<ip publique>` — ou `https://radar.mondomaine.fr` si un domaine
# pointe sur la machine. scripts/deploy.sh la renseigne.
#
# Elle DOIT contenir un hôte : Caddy n'active l'HTTPS automatique que s'il
# connaît un nom de domaine ou une adresse IP. Un `:443` nu fait écouter le
# port sans jamais émettre de certificat, et la poignée de main TLS échoue —
# le navigateur n'affiche alors rien du tout, même pas l'avertissement.
#
# Avec une IP, `tls internal` fait signer par l'autorité interne de Caddy
# (certificat avec SAN IP). Le navigateur avertit sur l'autorité inconnue :
# c'est attendu, à accepter une fois. Le trafic est chiffré, donc le mot de
# passe ne circule pas en clair. Avec un vrai domaine, retirer `tls internal`
# suffit à basculer sur Let's Encrypt.
#
# `basic_auth` (et non `basicauth`) : renommé en Caddy 2.8, image épinglée
# au-delà dans docker-compose.yml.
#
# Les valeurs sont injectées par substitution au chargement `{$VAR}` et non
# `{env.VAR}` : basic_auth est analysé au chargement, où le placeholder
# d'exécution n'est pas encore résolu.

{
	# Le port 80 n'est pas publié par docker-compose : pas de redirection.
	auto_https disable_redirects
}

{$RADAR_SITE} {
	tls internal

	basic_auth {
		{$RADAR_USER} {$RADAR_PASSWORD_HASH}
	}

	# Caddy ne bufferise pas les réponses en flux : /api/stream (SSE) passe tel
	# quel, sans l'équivalent du `proxy_buffering off` qu'exige nginx.
	reverse_proxy radar:3000

	log {
		output stderr
		format console
	}
}
