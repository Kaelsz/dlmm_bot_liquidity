# Frontal de Meteora Pool Radar.
#
# L'adresse du site est `RADAR_SITE` (dans radar.env), renseignée par
# scripts/deploy.sh. Elle DOIT être un nom d'hôte, jamais une adresse IP nue.
#
# Pourquoi : le SNI de TLS ne peut pas transporter une adresse IP (RFC 6066).
# Un navigateur ouvrant `https://<ip>/` n'envoie donc aucun nom, et le serveur
# doit deviner quel certificat présenter — chemin fragile, qui cassait ici la
# poignée de main avant même que la page ou l'avertissement s'affichent.
#
# La parade sans acheter de domaine : sslip.io, un service DNS public qui
# résout `116-203-133-235.sslip.io` vers `116.203.133.235`. On obtient un vrai
# nom d'hôte, donc un SNI valide — et surtout Let's Encrypt peut émettre un
# certificat authentique, ce qui supprime l'avertissement du navigateur.
#
# La validation ACME HTTP-01 exige que le port 80 soit joignable depuis
# internet : il est publié dans docker-compose.yml et ouvert par deploy.sh.
# C'est aussi pourquoi la redirection HTTP->HTTPS reste active ici.
#
# RADAR_TLS_DIRECTIVE permet de retomber sur `tls internal` (certificat
# auto-signé) quand ACME est impossible — machine sans accès entrant, réseau
# privé. Vide en fonctionnement normal.
#
# Le site est PUBLIC : plus d'authentification. Le dashboard n'expose que des
# données de marché déjà publiques, et /api/positions ne lit que de la donnée
# on-chain, elle aussi publique. Ce qui doit être protégé, ce n'est pas la
# lecture mais le QUOTA RPC — c'est fait côté application (limite par IP et
# plafond de wallets suivis), pas ici.

{$RADAR_SITE} {
	{$RADAR_TLS_DIRECTIVE}

	# Caddy ne bufferise pas les réponses en flux : /api/stream (SSE) passe tel
	# quel, sans l'équivalent du `proxy_buffering off` qu'exige nginx.
	reverse_proxy radar:3000

	log {
		output stderr
		format console
	}
}
