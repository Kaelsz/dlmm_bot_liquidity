{
  "name": "meteora-fee-sniper",
  "version": "0.1.0",
  "description": "Autonomous opportunistic fee-farming bot for Meteora DLMM & DAMM v2 pools on Solana",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "bigint-buffer",
      "bufferutil",
      "esbuild",
      "utf-8-validate"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "scan": "tsx src/index.ts scan",
    "paper": "tsx src/index.ts paper",
    "live": "tsx src/index.ts live",
    "report": "tsx src/index.ts report",
    "dashboard": "tsx src/index.ts dashboard",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "^1.1.5",
    "@meteora-ag/dlmm": "^1.5.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "better-sqlite3": "^11.8.0",
    "bn.js": "^5.2.1",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/bn.js": "^5.1.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
