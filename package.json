{
  "name": "meteora-pool-radar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "//": "pnpm 10 blocks install scripts by default; better-sqlite3 needs its native binding compiled.",
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe": "tsx scripts/probe-api.ts",
    "probe:positions": "tsx scripts/probe-positions.ts"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "^1.9.14",
    "@meteora-ag/zap-sdk": "^1.3.2",
    "@solana/wallet-standard-features": "^1.4.0",
    "@solana/web3.js": "^1.98.4",
    "@wallet-standard/app": "^1.1.1",
    "better-sqlite3": "^11.8.0",
    "next": "^15.1.6",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "pino-pretty": "^13.0.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
