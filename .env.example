# Toutes ces variables sont optionnelles — les défauts de src/config.ts
# suffisent pour un usage local. Aucune clé API n'est nécessaire : les
# données Meteora sont publiques.

# Fichier SQLite. En production, pointer vers un volume monté.
DB_PATH=data/radar.db

# Mettre à "off" pour servir l'UI sans lancer le collecteur
# (utile pour inspecter une base existante).
COLLECTOR=on

LOG_LEVEL=info

# Périodes des trois tiers de collecte, en millisecondes.
# DISCOVERY_INTERVAL_MS=60000
# NEW_POOLS_INTERVAL_MS=20000
# HOT_SET_INTERVAL_MS=12000

# --- Accès HTTP (utilisé par Caddy, cf. docker-compose.yml et Caddyfile) ---
# Renseignés automatiquement par scripts/deploy.sh. Le hash est du bcrypt :
# ne JAMAIS y mettre un mot de passe en clair, Caddy refuserait de démarrer.
# Pour le régénérer :
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'monmotdepasse'
# RADAR_USER=radar
# RADAR_PASSWORD_HASH=$2a$14$...
