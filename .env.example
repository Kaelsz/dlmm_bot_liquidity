# --- Mode ---
# DRY_RUN=true => paper trading only, no transaction is ever sent (default, mandatory before real capital)
DRY_RUN=true

# --- Solana ---
# Premium RPC strongly recommended (Helius / Triton). Never use the public endpoint in production.
RPC_URL=https://api.mainnet-beta.solana.com
# Optional dedicated RPC for sending transactions (e.g. staked connection)
RPC_SEND_URL=

# Wallet: either a path to a keypair JSON file, or a base58-encoded secret key.
# NEVER commit these. Only needed when DRY_RUN=false.
WALLET_KEYPAIR_PATH=
WALLET_SECRET_KEY_B58=

# --- Capital (USD) ---
CAPITAL_USD=1000

# --- Notifier (optional) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Storage ---
DB_PATH=data/bot.db

# --- Logging: trace|debug|info|warn|error ---
LOG_LEVEL=info

# --- Dashboard ---
DASHBOARD_PORT=8787
